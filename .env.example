# --- Supabase (Project Settings -> API) ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# Clave secreta: NUNCA la compartas ni la pongas en el navegador
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# --- Mercado Pago (Tus integraciones -> Credenciales de producción) ---
MP_ACCESS_TOKEN=APP_USR-...
# Opcional: clave secreta de la notificación webhook (Webhooks -> Clave secreta)
MP_WEBHOOK_SECRET=

# --- Sitio ---
# La dirección pública de tu tienda, sin barra final
NEXT_PUBLIC_SITE_URL=https://tienda-rojas.vercel.app
# Emails que pueden entrar al panel (separados por coma)
ADMIN_EMAILS=comercial@blueopendata.com
